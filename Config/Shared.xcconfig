// Apple TV 4K 3rd gen, tvOS 27. Deployment target matches installed SDK.
TVOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SDKROOT = appletvos
SUPPORTED_PLATFORMS = appletvos appletvsimulator
TARGETED_DEVICE_FAMILY = 3
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
SWIFT_STRICT_CONCURRENCY = complete
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_IDENTITY[sdk=appletvsimulator*] = -
CODE_SIGN_ENTITLEMENTS = Config/QuarkTheater.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = App Icon & Top Shelf Image
// Select your own team in Xcode Signing & Capabilities before a device build.
DEVELOPMENT_TEAM = LY2UZ2U7D2
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
